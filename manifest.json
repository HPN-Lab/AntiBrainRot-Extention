{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "version": "2.0",
  "permissions": [
    "storage",
    "tabs",
    "favicon",
    "alarms",
    "webNavigation",
    "notifications",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:7371/*",
    "*://facebook.com/*",
    "*://*.facebook.com/*",
    "*://youtube.com/*",
    "*://*.youtube.com/*"
  ],
  "optional_permissions": [
    "topSites",
    "notifications"
  ],
  "default_locale": "en_US",
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "scripts/service_worker.js"
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; connect-src 'self' http://127.0.0.1:7371; script-src 'self'; object-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; "
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/*"
      ],
      "run_at": "document_start",
      "js": [
        "/content.js"
      ],
      "css": [
        "/overlay.css"
      ]
    },
    {
      "matches": [
        "*://youtube.com/*",
        "*://*.youtube.com/*"
      ],
      "run_at": "document_start",
      "js": [
        "/scripts/undistracted-youtube.js"
      ]
    },
    {
      "matches": [
        "*://facebook.com/*",
        "*://*.facebook.com/*"
      ],
      "run_at": "document_start",
      "js": [
        "/scripts/undistracted-facebook.js"
      ]
    }
  ],
  "icons": {
    "64": "images/icon64.png",
    "128": "images/icon128.png",
    "256": "images/icon256.png",
    "512": "images/icon512.png",
    "1024": "images/icon1024.png"
  },
  "options_ui": {
    "page": "dashboard.html",
    "open_in_tab": true
  },
  "action": {
    "default_icon": {
      "128": "images/icon128.png"
    },
    "default_popup": "popup.html"
  }
}
