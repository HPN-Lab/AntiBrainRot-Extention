{
  "manifest_version": 3,

  "name": "VMU - AntiDoom",
  "description": "",
  "version": "2.0",


  "permissions": [
    "storage",
    "tabs",
    "favicon",
    "alarms",
    "webNavigation",
    "notifications",

    "activeTab"

  ],
  "optional_permissions": [
    "topSites",
    "notifications"
  ],
  "default_locale": "en",
  "optional_host_permissions": [
    "<all_urls>"
  ],


  "background": {
    "service_worker": "scripts/service_worker.js"
  },

  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; "
  },

  "content_scripts": [
    {
      "matches": [
        "*://*/*"
      ],
      "run_at": "document_start",
      "js": [
        "/content.js"
      ],
      "css": [
        "/overlay.css"
      ]
    },

    {
      "matches": [
        "*://youtube.com/*",
        "*://*.youtube.com/*"
      ],
      "run_at": "document_start",
      "js": [
        "/scripts/undistracted-youtube.js"
      ]
    },
    {
      "matches": [
        "*://facebook.com/*",
        "*://*.facebook.com/*"
      ],
      "run_at": "document_start",
      "js": [
        "/scripts/undistracted-facebook.js"
      ]
    }

  ],
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "32": "images/icon32.png",
    "64": "images/icon64.png",
    "128": "images/icon128.png",
    "256": "images/icon256.png",
    "512": "images/icon512.png",
    "1024": "images/icon1024.png"

  },

  "options_ui": {
    "page": "dashboard.html",
    "open_in_tab": true
  },

  "action": {
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/default.png",
      "32": "images/icon32.png",
      "64": "images/icon64.png",
      "128": "images/icon128.png",
      "256": "images/icon256.png",
      "512": "images/icon512.png",
      "1024": "images/icon1024.png"
    },
    "default_popup": "popup.html"

  }

}
